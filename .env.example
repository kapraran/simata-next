# Local (docker compose) settings. Copy to .env if you need to override.
API_PORT=3001
WEB_PORT=5173
DATA_DIR=/data

# HMAC pepper used to hash login keys and session tokens. Change it and every key stops working.
AUTH_PEPPER=dev-pepper-change-me
# Bearer token for the admin API (the `tools/admin` CLI). Leave empty to disable it.
ADMIN_TOKEN=dev-admin
# Public base URL of the web app, used by the admin CLI to build claim links.
APP_URL=http://localhost:5173
