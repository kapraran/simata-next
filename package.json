{
  "name": "simata",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "docker compose up --build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "import:pull": "npm run pull -w @simata/import --",
    "import:build": "npm run build-bank -w @simata/import",
    "import:seed": "npm run seed -w @simata/import",
    "import:legacy": "npm run legacy -w @simata/import --",
    "build:web": "npm run build -w @simata/web",
    "dev:worker": "wrangler dev",
    "deploy": "npm run build:web && wrangler deploy",
    "db:migrate:remote": "wrangler d1 migrations apply simata-next --remote",
    "db:migrate:local": "wrangler d1 migrations apply simata-next --local",
    "seed:cloud": "npm run seed:cloud -w @simata/import",
    "admin": "npm run cli -w @simata/admin --"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*"
  ]
}
